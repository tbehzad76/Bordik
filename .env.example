# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Development:
DATABASE_URL=sqlite:///./tasks.db
AUTO_CREATE_TABLES=true

# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://tasks_user:strong-password@127.0.0.1:5432/tasks
# AUTO_CREATE_TABLES=false

ACCESS_TOKEN_EXPIRE_MINUTES=30
# How long a browser/phone stays signed in without logging in again (days).
SESSION_DAYS=30
COOKIE_SECURE=false

# Rubika bot (optional). Set RUBIKA_ENABLED=true and put the bot token.
RUBIKA_ENABLED=false
RUBIKA_BOT_TOKEN=
RUBIKA_API_BASE=https://botapi.rubika.ir/v3
RUBIKA_POLL_INTERVAL_SECONDS=3
RUBIKA_SEND_METHOD=sendMessage
RUBIKA_UPDATES_METHOD=getUpdates
