# Copy to .env and adjust values before running docker compose.

# Required: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

POSTGRES_PASSWORD=replace-with-a-strong-database-password

APP_PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=60

# How long a browser/phone stays signed in without logging in again (days).
SESSION_DAYS=30

# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false

# Number of uvicorn worker processes.
WEB_CONCURRENCY=2

# Rubika bot (optional).
RUBIKA_ENABLED=false
RUBIKA_BOT_TOKEN=
RUBIKA_API_BASE=https://botapi.rubika.ir/v3
RUBIKA_POLL_INTERVAL_SECONDS=3
RUBIKA_SEND_METHOD=sendMessage
RUBIKA_UPDATES_METHOD=getUpdates
